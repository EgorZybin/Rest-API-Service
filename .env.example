# --- App ---
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sherlock
DB_USER=sherlock
DB_PASSWORD=sherlock

# --- Auth ---
CLIENT_API_KEY=change-me-client

# --- Accounts pool ---
ACCOUNTS_DIR=./accounts
ACCOUNT_REQUESTS_PER_HOUR=30
ACCOUNT_COOLDOWN_SECONDS=5
ACCOUNT_RESPONSE_TIMEOUT=60

# --- Sherlock bot ---
SHERLOCK_BOT_USERNAME=@mycommentinst_bot

# --- Dispatcher ---
DISPATCHER_IN_APP=false

# --- Webhook delivery ---
WEBHOOK_SIGNING_SECRET=super-long-random-secret
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_SWEEP_INTERVAL_SECONDS=5
WEBHOOK_BACKOFF_BASE_SECONDS=5
WEBHOOK_BACKOFF_MAX_SECONDS=3600
